# Copia este archivo a ".env" y ajusta los valores. ".env" NO se sube a git.
# Spring lo lee al arrancar (spring.config.import) y docker compose lo usa para la base de datos.

# --- Base de datos (Postgres en docker compose) ---
DB_NAME=horizontal
DB_USER=horizontal
DB_PASSWORD=cambiar-esta-contrasena

# --- Pool de conexiones a Postgres (control de recursos) ---
# DB_POOL_MAX: tope de conexiones simultaneas a la BD. No lo subas por encima del
#              max_connections de Postgres (por defecto 100) dividido entre tus instancias.
# DB_POOL_MIN: conexiones ociosas que se mantienen abiertas.
DB_POOL_MIN=2
DB_POOL_MAX=10

# --- Seguridad: llave que firma los JWT (minimo 32 caracteres) ---
JWT_SECRET=genera-una-llave-larga-y-aleatoria-de-minimo-32-caracteres

# --- CORS: origen del front-end ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Administrador inicial (solo se crea una vez si no existe; false en produccion) ---
SEED_ENABLED=true
SEED_ADMIN_IDENTIFICACION=1000000001
SEED_ADMIN_NOMBRE=Administrador del Conjunto
SEED_ADMIN_CORREO=admin@torresdelparque.com
SEED_ADMIN_CONTRASENA=Cambiar123!

# --- Pasarela de pagos (Wompi) ---
# Todo sale de Wompi > Desarrolladores (Llaves de API / Secretos para integracion tecnica).
# Las 4 llaves y PASARELA_URL_API_REST deben ser del MISMO ambiente (test o prod).
PASARELA_NOMBRE=Wompi
PASARELA_URL_API=https://checkout.wompi.co/p/
# Llave publica: abre el checkout
PASARELA_API_KEY=pub_test_CAMBIAR_POR_LA_LLAVE_REAL
# Secreto de integridad: firma el checkout
PASARELA_INTEGRITY_SECRET=test_integrity_CAMBIAR_POR_EL_SECRETO_REAL
# Secreto de eventos: verifica la firma del webhook
PASARELA_EVENTS_SECRET=test_events_CAMBIAR_POR_EL_SECRETO_REAL
# Llave privada: consulta la transaccion en la API de Wompi antes de aprobar
PASARELA_PRIVATE_KEY=prv_test_CAMBIAR_POR_LA_LLAVE_REAL
# API REST: https://sandbox.wompi.co/v1 (pruebas) o https://production.wompi.co/v1 (produccion)
PASARELA_URL_API_REST=https://sandbox.wompi.co/v1
# Pantalla del front a la que vuelve el residente despues de pagar (opcional)
PASARELA_REDIRECT_URL=http://localhost:3000/pagos/resultado
