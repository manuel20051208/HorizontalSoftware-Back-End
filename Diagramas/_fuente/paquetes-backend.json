 "cards": [
  {
   "dot": "emerald",
   "title": "Como leerlo",
   "items": [
    "Paquete que provee: su flecha 'provee' llega a la interfaz (piruleta)",
    "Paquete que requiere: su flecha 'requiere' sale hacia la interfaz (enchufe)",
    "controller, scheduler y bootstrap dependen de *Service, nunca de impl"
   ]
  },
  {
   "dot": "orange",
   "title": "Omitido",
   "items": [
    "dto, exception, cache y factory los usa casi todo",
    "TokenService (security) lo requieren config y AutenticacionServiceImpl",
    "policy y mapper son clases concretas, sin interfaz"
   ]
  }
 ]
